# Allowlist: only our own text work goes to git. ROM images, APKs, Xiaomi/Qualcomm binaries,
# photos, screenshots and downloaded ROMs stay local (size, licensing, privacy).
*
!*/
!*.py
!*.sh
!*.md
!*.tsv
!*.remove
!*.prop
!*.rc
!*.xml
!*.conf
!*.ini
!*.json
!*.meta
!*.txt
!.gitignore
!tools/erofs_patch/*.patch
!tools/erofs_patch/*.h
!secure_build/payload_tele/product/etc/selinux/*
!release/*.bat
!docs/screenshots/*.jpg
!tools/re/*.java

# Never publish raw device dumps or scratch work: getprop / settings dumps hold the IMEI, serials and MAC addresses.
# (These lines come after the allowlist so they win over the extension rules above.)
audit/agents/*/scratch/
*getprop*
*_all.txt
*imei*
*serial*
__pycache__/
*.log
*.bak
*.draft*

# Backups of the phone (persist, EFS, modem) live outside the repo in ~/poco_f4_private_backup/ and must never be copied in.
