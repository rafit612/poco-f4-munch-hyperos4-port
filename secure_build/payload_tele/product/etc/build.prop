# TEMPORARY DEBUG (setup-loop diagnosis): USB debugging on from first boot, no RSA prompt. Remove in the final build.

# munch tuning (2026-10-23 audit): official HyperOS 1 heap values, USAP pool, cooler background dexopt
dalvik.vm.heaptargetutilization=0.5
dalvik.vm.heapminfree=2m
persist.sys.usap_pool_enabled=true
dalvik.vm.background-dex2oat-threads=4
dalvik.vm.background-dex2oat-cpu-set=0,1,2,3

# POCO F4: vendor build.prop forces persist.dbg.volte_avail_ovr/vt_avail_ovr=1 (porter addition; commented out
# in official munch HyperOS 1). With 1, TeleService hides the VoLTE switch outside its region list, so reset to
# the official behaviour: VoLTE availability comes from carrier config for every operator.
persist.dbg.volte_avail_ovr=0
persist.dbg.vt_avail_ovr=0

# POCO F4: explicit build fingerprint with a release tag. TeleService (CarrierConfigLoader) keeps each SIM's
# carrier config cached until Build.FINGERPRINT changes, so change the tag on every release, otherwise users
# who update keep the old VoLTE / Wi-Fi calling settings. ro.build.version.incremental stays unchanged.
ro.build.fingerprint=POCO/munch/munch:17/CP2A.260605.016/OS4.0.0.24.XPKCNXM.T20261031b:user/release-keys
